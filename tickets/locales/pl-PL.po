msgstr ""
"Argument `/modal/{count}/placeholder` musi być krótszy niż 100 znaków."

#: tickets\converters.py:219
msgid "The argument `/modal/{count}/min_length` must be between 0 and 1000."
msgstr "Argument `/modal/{count}/min_length` musi być między 0 a 1000."

#: tickets\converters.py:227
msgid "The argument `/modal/{count}/max_length` must be between 0 and 1000."
msgstr "Argument `/modal/{count}/max_length` musi być między 0 a 1000."

