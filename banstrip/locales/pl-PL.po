#: banstrip.py:24
#, docstring
msgid ""
"\n"
"    Strip all roles from a member when a configured BAN role is applied,\n"
"    and run a configurable command (e.g. Verify) when the BAN role is removed.\n"
"\n"
"    Includes `ban`/`unban`/`banlist` commands with reasons, optional durations\n"
"    in days (with automatic expiry), and per-guild permissions for each action.\n"
"    "
msgstr ""
"\n"
"    Zdejmuje wszystkie role z członka po nadaniu skonfigurowanej roli BAN,\n"
"    a po jej usunięciu uruchamia konfigurowalną komendę (np. Verify).\n"
"\n"
"    Zawiera komendy `ban`/`unban`/`banlist` z powodami, opcjonalnym czasem\n"
"    trwania w dniach (z automatycznym wygasaniem) oraz uprawnieniami per serwer.\n"
"    "

#: banstrip.py:72
msgid "banstrip records for user {user_id}:\n"
msgstr "Rekordy banstrip dla użytkownika {user_id}:\n"

#: banstrip.py:101
#, docstring
msgid ""
"\n"
"        Apply the BAN role to a member (stripping their other roles).\n"
"\n"
"        `details` may start with a number of days (0 or empty = permanent),\n"
"        optionally followed by a reason.\n"
"        Example: `[p]banstrip ban @user 7 spamming`\n"
"        "
msgstr ""
"\n"
"        Nadaje członkowi rolę BAN (zdejmując jego pozostałe role).\n"
"\n"
"        `details` może zaczynać się od liczby dni (0 lub puste = permanentny),\n"
"        a po niej od opcjonalnego powodu.\n"
"        Przykład: `[p]banstrip ban @user 7 spamming`\n"
"        "

#: banstrip.py:109
msgid "You don't have permission to ban members."
msgstr "Nie masz uprawnień do banowania członków."

#: banstrip.py:113
msgid "You can't ban yourself."
msgstr "Nie możesz zbanować samego siebie."

#: banstrip.py:115
msgid "You can't ban the server owner."
msgstr "Nie możesz zbanować właściciela serwera."

#: banstrip.py:121
msgid "You can't ban someone whose role has the `ban_members` permission."
msgstr "Nie możesz zbanować kogoś, czyja rola ma uprawnienie `ban_members`."

#: banstrip.py:126
msgid "You can't ban someone with a role equal to or higher than yours."
msgstr "Nie możesz zbanować kogoś z rolą równą lub wyższą niż twoja."

#: banstrip.py:131
msgid "I can't manage that member's roles (their top role is too high)."
msgstr "Nie mogę zarządzać rolami tego członka (jego najwyższa rola jest za wysoka)."

#: banstrip.py:142
msgid "I don't have permission to add the BAN role."
msgstr "Nie mam uprawnień do nadania roli BAN."

#: banstrip.py:144
