#: views/voteview.py:82
#, docstring
#: views/voteview.py:86
msgid "Return True if the user can vote"
msgstr "Zwróć True, jeśli użytkownik może głosować"

#: views/voteview.py:114
msgid "This suggestion no longer exists in the config!"
msgstr "Ta sugestia już nie istnieje w konfiguracji!"

#: views/voteview.py:124
msgid "You do not have any of the required roles to vote."
msgstr "Nie masz żadnej z wymaganych ról, aby głosować."

#: views/voteview.py:133
msgid "Your account is too new! You must wait `{tleft}` before you can vote."
msgstr "Twoje konto jest zbyt nowe! Musisz odczekać `{tleft}`, zanim zagłosujesz."

#: views/voteview.py:147
msgid "You joined the server too recently! You must wait `{tleft}` before you can vote."
msgstr "Dołączyłeś na serwer zbyt niedawno! Musisz odczekać `{tleft}`, zanim zagłosujesz."

#: views/voteview.py:162
msgid "You must be level {level} or higher to vote."
msgstr "Musisz mieć poziom {level} lub wyższy, aby głosować."

#: views/voteview.py:163
msgid "Your in-game profile must be registered in order to vote on suggestions.\n"
msgstr "Twój profil w grze musi być zarejestrowany, abyś mógł głosować na sugestiach.\n"

#: views/voteview.py:169
msgid "Use the {} command to link your discord account."
msgstr "Użyj komendy {}, aby połączyć swoje konto Discord."

#: views/voteview.py:192 views/voteview.py:233
msgid "You must have at least {} hours of playtime to vote."
msgstr "Musisz mieć co najmniej {} godzin gry, aby głosować."

#: views/voteview.py:195
msgid "You cannot vote on your own suggestion."
msgstr "Nie możesz głosować na własną sugestię."

#: views/voteview.py:203
msgid "You have switched your downvote to an upvote."
msgstr "Zmieniłeś swój głos na nie na głos na tak."

#: views/voteview.py:208
msgid "You have removed your upvote."
msgstr "Usunąłeś swój głos na tak."

#: views/voteview.py:236
msgid "You have upvoted this suggestion."
msgstr "Zagłosowałeś na tę sugestię na tak."

#: views/voteview.py:244
msgid "You have switched your upvote to a downvote."
msgstr "Zmieniłeś swój głos na tak na głos na nie."

#: views/voteview.py:249
msgid "You have removed your downvote."
msgstr "Usunąłeś swój głos na nie."

msgid "You have downvoted this suggestion."
msgstr "Zagłosowałeś na tę sugestię na nie."

